<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <add key="github" value="https://nuget.pkg.github.com/raulidavid/index.json" />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
        <!-- <add key="offline" value="/home/raulidavid/LocalNuget" /> -->
    </packageSources>
    <packageSourceCredentials>
        <github>
            <add key="Username" value="raulidavid" />
            <add key="ClearTextPassword" value="${NUGET_TOKEN}" />
        </github>
    </packageSourceCredentials>
</configuration>